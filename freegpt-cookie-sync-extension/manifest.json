{
  "manifest_version": 3,
  "name": "FreeGPT Session Sync",
  "version": "1.0.0",
  "description": "Extract active ChatGPT session credentials for FreeGPT in one click.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FreeGPT Session Sync"
  }
}
